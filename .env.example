DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900

# Each backend service authenticates itself to access-control's internal/authz
# endpoints with its own key (not a single shared secret). Every var is
# optional — unset ones fall back to a deterministic dev-service-key-<name>
# value (see resolveOwnServiceApiKey in @platform/auth-kit) so a fresh clone
# still works end-to-end without configuring all nine.
SERVICE_API_KEY_ACCESS_CONTROL=
SERVICE_API_KEY_USER_MANAGEMENT=
SERVICE_API_KEY_EXPENSE_MANAGEMENT=
SERVICE_API_KEY_PAYROLL=
SERVICE_API_KEY_AUDIT=
SERVICE_API_KEY_REPORTING=
SERVICE_API_KEY_WORKFLOW=
SERVICE_API_KEY_NOTIFICATION=
SERVICE_API_KEY_INVOICE_MANAGEMENT=
